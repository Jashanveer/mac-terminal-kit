#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SCRIPT_PATH="$LINK_TARGET"
  else
    SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$LINK_TARGET"
  fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
if [[ -n "${MACTERM_REPO_ROOT:-}" ]]; then
  ROOT_DIR="$MACTERM_REPO_ROOT"
else
  ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

for library in common managed-block backup packages commands; do
  # shellcheck source=/dev/null
  source "$ROOT_DIR/lib/$library.sh"
done

usage() {
  cat <<'EOF'
Usage: macterm <command> [options]

Commands:
  install [--no-packages] [--dry-run]  Install tools and managed configuration
  doctor                              Check the current setup
  backup                              Create a restorable snapshot
  restore <backup-id>                 Restore a snapshot
  uninstall [--purge-packages]        Remove managed setup
  info                                Show system information with fastfetch
  help                                Show this help
EOF
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

case "$command_name" in
  install) command_install "$@" ;;
  doctor) command_doctor "$@" ;;
  backup) command_backup "$@" ;;
  restore) command_restore "$@" ;;
  uninstall) command_uninstall "$@" ;;
  info) command_info "$@" ;;
  help|-h|--help) usage ;;
  *) die "Unknown command: $command_name (run 'macterm help')" ;;
esac
