[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	dark = true
	navigate = true
	line-numbers = true
	syntax-theme = OneHalfDark
	file-style = bold "#7cc7ff"
	file-decoration-style = omit
	hunk-header-style = syntax "#8b96a1"
	hunk-header-decoration-style = omit
	line-numbers-left-style = "#5d6873"
	line-numbers-right-style = "#5d6873"
	line-numbers-minus-style = "#f07178"
	line-numbers-plus-style = "#9be28f"
	minus-style = syntax "#3a2228"
	minus-emph-style = syntax "#6a2f39"
	plus-style = syntax "#203525"
	plus-emph-style = syntax "#31553a"

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default
